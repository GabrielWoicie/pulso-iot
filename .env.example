# Copie para .env na pasta de execução e preencha antes de iniciar.
# O backend carrega .env automaticamente; variáveis do ambiente têm prioridade.
# Nunca faça commit do arquivo preenchido.
DATABASE_URL=postgres://pulso_app:SUBSTITUA@127.0.0.1:5432/postgres?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
JWT_SECRET=SUBSTITUA_POR_32_OU_MAIS_CARACTERES_ALEATORIOS
# Base64 PADRÃO, exatamente 32 bytes. Gere: openssl rand -base64 32
MQTT_CREDENTIAL_KEY_B64=
MQTT_BROKER=mqtts://broker.woicie.com.br:8883
MQTT_CLIENT_ID=svc-backend
MQTT_USERNAME=svc-backend
MQTT_PASSWORD=
EMQX_API_URL=http://127.0.0.1:18083
EMQX_API_KEY=
EMQX_API_SECRET=
CORS_ORIGIN=http://localhost:3000
# Somente no comando bootstrap-admin; remova ADMIN_* deste arquivo após usar.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
